# Copy to .env locally. Never commit or paste the actual key into chat.
OPENAI_API_KEY=
AGENT_API_BASE_URL=https://api.openai.com/v1
AGENT_API_MODEL=gpt-6-astra
AGENT_API_TIMEOUT_MS=60000
AGENT_REASONING_EFFORT=low
AGENT_MAX_COMPLETION_TOKENS=2048
# agent:local-run remains an explicit Qwen option; it does not receive OPENAI_API_KEY.
